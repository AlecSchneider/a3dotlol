{
  "name": "a3dotlol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "core-js@3.49.0": false,
    "esbuild@0.27.0": true,
    "fsevents@2.3.3": false,
    "msgpackr-extract@3.0.4": false,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "build": "next build",
    "check": "eslint . && tsc --noEmit",
    "convex:deploy": "convex deploy",
    "convex:dev": "convex dev",
    "dev": "next dev --turbo",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "next build && next start",
    "start": "next start",
    "test": "vitest",
    "test:once": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@convex-dev/rate-limiter": "^0.3.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "convex": "^1.45.0",
    "effect": "4.0.0-rc.112",
    "next": "^15.5.24",
    "posthog-js": "^1.422.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "convex-test": "^0.0.56",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "postcss": "8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.3"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "npm@11.19.1"
}
